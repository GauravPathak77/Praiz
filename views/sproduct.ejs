                                                            </span>
                                                            <% } %>
                                                                <img src="<%= item.thumbnail %>" class="product-thumb"
                                                                    alt="similar-product">
                                                                <img src="<%= item.images[0] %>" alt="similar-product-s"
                                                                    class="img-fluid product-thumb-s">
                                                    </div>
                                                </a>
                                                <div class="product-info">
                                                    <div class="product-dets">
                                                        <a href="/product/<%= item.slug %>">
                                                            <div class="product-name">
                                                                <%= item.title %>
                                                            </div>
                                                        </a>
                                                        <div class="product-price">&#8377 <%= item.sellingPrice %>
                                                                </span>
                                                                <span class="product-price"><del>&#8377 <%= item.price
                                                                            %>
                                                                    </del></span>
                                                        </div>
                                                        <div class="py-1">
                                                            <i class="fa-solid fa-star"></i>
                                                            <i class="fa-solid fa-star"></i>
                                                            <i class="fa-solid fa-star"></i>
                                                            <i class="fa-solid fa-star"></i>
                                                            <i class="fa-regular fa-star"></i>
                                                        </div>
                                                    </div>

                                                    <div class="card-big-btn">
