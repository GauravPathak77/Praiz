                                                            <% if(product.quantity===0){ %>
                                                                <button type="button"
                                                                    class="btn btn-outline-primary card-btn add-to-cart"
                                                                    disabled>Add to Cart</button>
                                                                <% }else{ %>
                                                                    <button type="button"
                                                                        class="btn btn-outline-primary card-btn add-to-cart"
                                                                        onclick="add_to_cart('<%= product._id %>', '<%= product.slug %>', '<%= product.title %>', '<%= product.images[0] %>', '<%= product.quantity %>', '<%= product.price %>', '<%= product.sellingPrice %>', '<%= product.discount %>', '<%= product.color %>', '<%= user.refreshToken %>')">Add
                                                                        to Cart <i
                                                                            class="d-inline d-sm-none fa-solid fa-cart-shopping"
                                                                            style="color: #ffffff;"
                                                                            aria-hidden="true"></i></button>
                                                                    <% } %>
                                                                        <button type="button"
                                                                            class="wishlist-button-small"
                                                                            onclick="add_to_wishlist('<%= product._id %>', `<%= user?user._id:' ' %>`)">
                                                                            <i class="fa-regular fa-heart"></i>
                                                                        </button>
                                                                        <button type="button"
                                                                            class="wishlist-button-small-mob btn btn-outline-primary"
                                                                            onclick="add_to_wishlist('<%= product._id %>', `<%= user?user._id:' ' %>`)">
                                                                            <i class="fa-regular fa-heart"
                                                                                style="color: #132043;font-size: .9rem;"
                                                                                aria-hidden="true"></i></button>
                                                                        <% } else { %>
                                                                            <% if(product.quantity===0){ %>
                                                                                <button type="button"
