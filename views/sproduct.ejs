                        </div>
                    </div>
                </div>

                <div style="position: relative;">
                    <button class="pre-btn"><i class="fa-solid fa-arrow-left" style="color: #202022;"></i></i></button>
                    <button class="nxt-btn"><i class="fa-solid fa-arrow-right" style="color: #202022;"></i></i></button>

